cmake_minimum_required(VERSION 3.20)

# Read CTest's generated registration once, instead of starting three listing
# processes. Actual Quick and Full executions independently exercise the filters.
# A nested CTest invocation writes Testing/Temporary even for --show-only.
# Include the real generated registrations from a private listing directory so
# selection validation cannot truncate the enclosing regression run's log/cost data.
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef listing_id)
set(listing_dir "${BUILD_DIR}/selection-listing-${listing_id}")
if(EXISTS "${listing_dir}")
  message(FATAL_ERROR "Selection listing directory already exists")
endif()
file(MAKE_DIRECTORY "${listing_dir}")
file(WRITE "${listing_dir}/CTestTestfile.cmake"
  "include(\"${BUILD_DIR}/CTestTestfile.cmake\")\n")
execute_process(COMMAND "${CTEST}" --test-dir "${listing_dir}" --show-only=json-v1
  RESULT_VARIABLE result OUTPUT_VARIABLE selection ERROR_VARIABLE error)
# Only this newly created child of the configured build directory is removed.
file(REMOVE_RECURSE "${listing_dir}")
if(NOT result EQUAL 0)
  message(FATAL_ERROR "CTest selection failed: ${error}")
endif()
string(JSON count LENGTH "${selection}" tests)
if(count EQUAL 0)
  message(FATAL_ERROR "CTest registration is empty")
endif()
math(EXPR last "${count} - 1")
set(all)
set(full)
set(quick)
set(libraries)
foreach(index RANGE 0 ${last})
  string(JSON name GET "${selection}" tests ${index} name)
  list(APPEND all "${name}")
  string(JSON properties LENGTH "${selection}" tests ${index} properties)
  if(properties GREATER 0)
    math(EXPR last_property "${properties} - 1")
    foreach(property RANGE 0 ${last_property})
      string(JSON key GET "${selection}" tests ${index} properties ${property} name)
      if(key STREQUAL "DISABLED")
        string(JSON disabled GET "${selection}" tests ${index} properties ${property} value)
        if(disabled)
          message(FATAL_ERROR "A registered regression was disabled: ${name}")
        endif()
      elseif(key STREQUAL "LABELS")
        string(JSON labels LENGTH "${selection}" tests ${index} properties ${property} value)
        math(EXPR last_label "${labels} - 1")
        foreach(label_index RANGE 0 ${last_label})
          string(JSON label GET "${selection}" tests ${index} properties ${property} value ${label_index})
          if(label STREQUAL "full" OR label STREQUAL "quick" OR label STREQUAL "libraries")
            list(APPEND ${label} "${name}")
          endif()
        endforeach()
      endif()
    endforeach()
  endif()
endforeach()
list(SORT all)
list(SORT full)
list(SORT quick)
set(classified ${full} ${libraries})
list(REMOVE_DUPLICATES classified)
list(SORT classified)
if(NOT all STREQUAL classified)
  message(FATAL_ERROR "Full and explicit Libraries labels do not include every registered test")
endif()
foreach(name IN LISTS libraries)
  if(name IN_LIST quick OR name IN_LIST full)
    message(FATAL_ERROR "Explicit live-network suite leaked into regular selection: ${name}")
  endif()
endforeach()

set(expected_quick library_compatibility_unit redirection_unit redirection_windows stage5_restart stage5_library_metadata stage5_library_transactions stage5_library_caches
  stage5_unified_unit reliability_inheritance reliability_lifecycle
  stage4_console_view stage4_watcher stage4_scheduler stage4_console_model
  stage4_channels stage4_appearance stage4_prompts doctor_unit
  maintenance_paths maintenance_output maintenance_handles maintenance_arguments
  stage3_session stage3_tree doctor_without_path
  cli_version cli_help cli_unknown cli_extra cli_doctor test_selection stage5_unit stage5_ui_forms stage5_github_versions stage5_ui_layout)
set(integration stage5_unified_projects stage5_unified_raylib reliability_gui_flow reliability_queue reliability_freshness
  stage4_auto_build maintenance_unicode_project stage3_projects stage2_integration
  stage5_projects stage5_presets stage5_libraries stage5_ui_audit)
list(SORT expected_quick)
if(NOT quick STREQUAL expected_quick)
  message(FATAL_ERROR "Quick selection changed unexpectedly: ${quick}")
endif()
foreach(name IN LISTS expected_quick integration)
  if(NOT name IN_LIST full)
    message(FATAL_ERROR "Original regression missing from Full: ${name}")
  endif()
endforeach()
foreach(name IN LISTS integration)
  if(name IN_LIST quick)
    message(FATAL_ERROR "Expensive project-build test unexpectedly selected by Quick: ${name}")
  endif()
endforeach()
file(READ "${SCRIPT}" script)
string(FIND "${script}" "[string]$TestMode = 'Full'" default_full)
if(default_full LESS 0)
  message(FATAL_ERROR "Build script must default to Full, not silently switch approval to Quick")
endif()
list(LENGTH quick quick_count)
list(LENGTH full full_count)
message(STATUS "Selection verified: Quick=${quick_count}; Full=${full_count}; default=Full")
