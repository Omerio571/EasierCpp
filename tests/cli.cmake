if(CASE STREQUAL "version")
  set(args --version)
  if(NOT DEFINED EXPECTED_VERSION)
    message(FATAL_ERROR "Version contract requires the authoritative CMake project version")
  endif()
  set(expected "EasierCpp ${EXPECTED_VERSION}\n")
elseif(CASE STREQUAL "help")
  set(args --help)
elseif(CASE STREQUAL "unknown")
  set(args unknown)
elseif(CASE STREQUAL "extra")
  set(args --version extra)
elseif(CASE STREQUAL "doctor")
  set(args doctor)
endif()
execute_process(COMMAND "${APP}" ${args} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(CASE STREQUAL "unknown" OR CASE STREQUAL "extra")
  if(NOT result EQUAL 2 OR NOT error MATCHES "Invalid arguments")
    message(FATAL_ERROR "Expected invalid arguments exit 2: ${result} ${error}")
  endif()
elseif(CASE STREQUAL "doctor")
  if(NOT result MATCHES "^[01]$" OR NOT output MATCHES "EasierCpp environment doctor" OR NOT output MATCHES "cmake")
    message(FATAL_ERROR "Invalid doctor output: ${result} ${output}")
  endif()
else()
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Unexpected exit: ${result} ${error}")
  endif()
  if(CASE STREQUAL "version" AND NOT output STREQUAL expected)
    message(FATAL_ERROR "Unexpected version: ${output}")
  elseif(CASE STREQUAL "help" AND NOT output MATCHES "Usage:")
    message(FATAL_ERROR "Missing usage: ${output}")
  endif()
endif()
