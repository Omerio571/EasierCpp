include_guard(GLOBAL)

# Explicit target opt-in only. Never propagate PCH to a dependency's consumers or
# reuse artifacts across targets/configurations/build trees with different flags.
function(easiercpp_target_pch target)
    if(NOT TARGET "${target}")
        message(WARNING "EasierCpp PCH: target ${target} not found; skipped")
        return()
    endif()
    cmake_parse_arguments(PCH "" "" "HEADERS" ${ARGN})
    get_target_property(kind "${target}" TYPE)
    get_target_property(imported "${target}" IMPORTED)
    get_target_property(alias "${target}" ALIASED_TARGET)
    get_target_property(existing "${target}" PRECOMPILE_HEADERS)
    get_target_property(reuse "${target}" PRECOMPILE_HEADERS_REUSE_FROM)
    get_target_property(disabled "${target}" DISABLE_PRECOMPILE_HEADERS)
    if(imported OR alias OR existing OR reuse OR disabled OR CMAKE_DISABLE_PRECOMPILE_HEADERS
        OR NOT kind MATCHES "^(EXECUTABLE|STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|OBJECT_LIBRARY)$"
        OR NOT CMAKE_CXX_COMPILER_ID MATCHES "^(MSVC|Clang)$" OR NOT PCH_HEADERS)
        message(STATUS "EasierCpp PCH: ${target} retained unchanged (not eligible or project-owned PCH)")
        return()
    endif()
    get_target_property(sources "${target}" SOURCES)
    set(has_cxx FALSE)
    foreach(source IN LISTS sources)
        get_source_file_property(language "${source}" TARGET_DIRECTORY "${target}" LANGUAGE)
        if(source MATCHES "\\.(cpp|cxx|cc|C)$" OR language STREQUAL "CXX")
            set(has_cxx TRUE)
        endif()
        foreach(property COMPILE_FLAGS COMPILE_OPTIONS COMPILE_DEFINITIONS)
            get_source_file_property(value "${source}" TARGET_DIRECTORY "${target}" "${property}")
            if(value)
                message(STATUS "EasierCpp PCH: ${target} skipped (source-specific compile settings)")
                return()
            endif()
        endforeach()
    endforeach()
    if(NOT has_cxx)
        message(STATUS "EasierCpp PCH: ${target} skipped (no known C++ sources)")
        return()
    endif()
    get_target_property(base "${target}" SOURCE_DIR)
    set(headers)
    foreach(header IN LISTS PCH_HEADERS)
        if(header MATCHES "^<([^<>]+)>$")
            list(APPEND headers "$<$<COMPILE_LANGUAGE:CXX>:<${CMAKE_MATCH_1}$<ANGLE-R>>")
        else()
            cmake_path(ABSOLUTE_PATH header BASE_DIRECTORY "${base}" NORMALIZE)
            if(NOT EXISTS "${header}")
                message(WARNING "EasierCpp PCH: ${target} skipped (header not found: ${header})")
                return()
            endif()
            list(APPEND headers "$<$<COMPILE_LANGUAGE:CXX>:${header}>")
        endif()
    endforeach()
    target_precompile_headers("${target}" PRIVATE ${headers})
    message(STATUS "EasierCpp PCH: enabled for ${target}")
endfunction()
