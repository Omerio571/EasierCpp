#pragma code_page(65001)
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Omer Sertkan\0"
            VALUE "FileDescription", "EasierCpp — Make Your Life Easier\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "ProductName", "EasierCpp\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 Omer Sertkan\0"
#ifdef EASIERCPP_GUI
            VALUE "OriginalFilename", "EasierCpp-Gui.exe\0"
#else
            VALUE "OriginalFilename", "EasierCpp.exe\0"
#endif
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
