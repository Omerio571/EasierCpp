# Included after the dependency has configured. Graph aliases are candidates only;
# every advertised target is checked against the actual consumer-visible graph.
function(cpplivelab_collect directory)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    get_property(imported DIRECTORY "${directory}" PROPERTY IMPORTED_TARGETS)
    set_property(GLOBAL APPEND PROPERTY CPPLIVELAB_CANDIDATES ${targets} ${imported})
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        cpplivelab_collect("${child}")
    endforeach()
endfunction()
cpplivelab_collect("${CMAKE_CURRENT_SOURCE_DIR}")
if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/target-graph.dot")
    file(STRINGS "${CMAKE_CURRENT_SOURCE_DIR}/target-graph.dot" nodes REGEX "label =")
    foreach(node IN LISTS nodes)
        # CMake's graph labels contain the backing name followed by (alias) names.
        # Unlike expanded tracing this records no unrelated command arguments.
        string(REGEX MATCHALL "\\([A-Za-z0-9_.:+-]+\\)" aliases "${node}")
        foreach(alias IN LISTS aliases)
            string(REGEX REPLACE "[()]" "" name "${alias}")
            set_property(GLOBAL APPEND PROPERTY CPPLIVELAB_CANDIDATES "${name}")
        endforeach()
    endforeach()
endif()
get_property(candidates GLOBAL PROPERTY CPPLIVELAB_CANDIDATES)
list(REMOVE_DUPLICATES candidates)
file(WRITE "${CMAKE_CURRENT_SOURCE_DIR}/targets.txt" "")
file(WRITE "${CMAKE_CURRENT_SOURCE_DIR}/target-details.txt" "")
file(REAL_PATH "${CPPLIVELAB_DEPENDENCY_SOURCE}" dependency_source)
file(TO_CMAKE_PATH "${dependency_source}" dependency_source)
foreach(name IN LISTS candidates)
    if(NOT name MATCHES "^[A-Za-z0-9_.:+-]+$" OR NOT TARGET "${name}")
        continue()
    endif()
    get_target_property(type "${name}" TYPE)
    if(NOT type MATCHES "^(STATIC|SHARED|INTERFACE|OBJECT)_LIBRARY$")
        continue()
    endif()
    get_target_property(alias "${name}" ALIASED_TARGET)
    get_target_property(owner "${name}" SOURCE_DIR)
    file(TO_CMAKE_PATH "${owner}" owner)
    get_target_property(imported "${name}" IMPORTED)
    if(NOT alias)
        set(alias "")
    endif()
    cmake_path(IS_PREFIX dependency_source "${owner}" NORMALIZE owned)
    string(TOLOWER "${name}" lower_name)
    set(primary 0)
    if(owned AND NOT owner MATCHES "/(extlibs|_deps|third_party|thirdparty|vendor|external)(/|$)"
        AND NOT lower_name MATCHES "(^|[-_:])(main|test|tests|example|examples)($|[-_:])")
        set(primary 1)
    endif()
    file(APPEND "${CMAKE_CURRENT_SOURCE_DIR}/targets.txt" "${name}\n")
    file(APPEND "${CMAKE_CURRENT_SOURCE_DIR}/target-details.txt"
        "${name}|${type}|${alias}|${owner}|${imported}|${primary}\n")
endforeach()
