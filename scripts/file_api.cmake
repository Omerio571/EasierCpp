cmake_minimum_required(VERSION 3.20)
# CMake supplies the JSON parser; the manager consumes a small UTF-8 line manifest.
file(GLOB indexes "${BUILD}/.cmake/api/v1/reply/index-*.json")
list(SORT indexes)
list(LENGTH indexes count)
if(count EQUAL 0)
    message(FATAL_ERROR "CMake produced no File API index")
endif()
list(GET indexes -1 index)
file(READ "${index}" data)
string(JSON generator GET "${data}" cmake generator name)
file(WRITE "${BUILD}/generator.txt" "${generator}")
string(JSON model_file GET "${data}" reply codemodel-v2 jsonFile)
file(READ "${BUILD}/.cmake/api/v1/reply/${model_file}" model)
string(JSON configurations LENGTH "${model}" configurations)
math(EXPR last "${configurations} - 1")
set(result "")
set(libraries "")
set(runtime_paths)
foreach(configuration RANGE 0 ${last})
    string(JSON name GET "${model}" configurations ${configuration} name)
    if(NOT name STREQUAL "${CONFIG}" AND NOT name STREQUAL "")
        continue()
    endif()
    string(JSON targets LENGTH "${model}" configurations ${configuration} targets)
    if(targets EQUAL 0)
        continue()
    endif()
    math(EXPR last_target "${targets} - 1")
    foreach(target RANGE 0 ${last_target})
        string(JSON target_file GET "${model}" configurations ${configuration} targets ${target} jsonFile)
        file(READ "${BUILD}/.cmake/api/v1/reply/${target_file}" detail)
        string(JSON type GET "${detail}" type)
        if(type MATCHES "^(STATIC|SHARED|MODULE|INTERFACE)_LIBRARY$")
            string(JSON library_name GET "${detail}" name)
            string(APPEND libraries "${library_name} (${type})\n")
        endif()
        if(type MATCHES "^(SHARED|MODULE)_LIBRARY$")
            string(JSON artifacts ERROR_VARIABLE no_artifact LENGTH "${detail}" artifacts)
            if(NOT no_artifact AND artifacts GREATER 0)
                math(EXPR last_artifact "${artifacts} - 1")
                foreach(artifact_index RANGE 0 ${last_artifact})
                    string(JSON runtime_file GET "${detail}" artifacts ${artifact_index} path)
                    if(runtime_file MATCHES "\\.[dD][lL][lL]$")
                        cmake_path(ABSOLUTE_PATH runtime_file BASE_DIRECTORY "${BUILD}" NORMALIZE)
                        cmake_path(GET runtime_file PARENT_PATH runtime_directory)
                        list(APPEND runtime_paths "${runtime_directory}")
                    endif()
                endforeach()
            endif()
        endif()
        if(type STREQUAL "EXECUTABLE")
            string(JSON target_name GET "${detail}" name)
            string(JSON artifact GET "${detail}" artifacts 0 path)
            cmake_path(ABSOLUTE_PATH artifact BASE_DIRECTORY "${BUILD}" NORMALIZE)
            string(APPEND result "${target_name}\n${artifact}\n")
        endif()
    endforeach()
endforeach()
file(WRITE "${BUILD}/executables.txt" "${result}")
file(WRITE "${BUILD}/libraries.txt" "${libraries}")
list(REMOVE_DUPLICATES runtime_paths)
list(JOIN runtime_paths "\n" runtime_text)
file(WRITE "${BUILD}/runtime-paths.txt" "${runtime_text}")

# Proof of the exact derived metadata and reader version. CMake owns the indexed
# replies and never replaces one with different contents under the same name.
# A changed index/configuration/reader or any damaged manifest invalidates reuse.
get_filename_component(index_name "${index}" NAME)
set(snapshot "1\n${CONFIG}\n${index_name}\n")
foreach(manifest executables.txt generator.txt libraries.txt runtime-paths.txt)
    file(READ "${BUILD}/${manifest}" bytes HEX)
    string(APPEND snapshot "${bytes}\n")
endforeach()
file(READ "${CMAKE_CURRENT_LIST_FILE}" reader HEX)
string(APPEND snapshot "${reader}\n")
file(WRITE "${BUILD}/file-api.snapshot.tmp" "${snapshot}")
file(RENAME "${BUILD}/file-api.snapshot.tmp" "${BUILD}/file-api.snapshot")
